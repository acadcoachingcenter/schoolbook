# SchoolBook environment variables
# --------------------------------
# LOCAL DEV ONLY. In production, set these as Cloudflare Pages secrets:
#   wrangler pages secret put GROQ_API_KEY --project-name=schoolbook
#   wrangler pages secret put GROQ_MODEL   --project-name=schoolbook
#
# NEVER prefix secrets with VITE_ — anything with that prefix is bundled
# into client-side JavaScript and becomes publicly visible.

# LLM provider (generation)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings — Workers AI is used by default (no key needed, it's a binding).
# Set this only if you swap to an external embedding provider.
EMBEDDING_PROVIDER=workers-ai
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Vectorize (used by the offline migration script, scripts/migration/migrate-vector-data.ts —
# the deployed Worker itself talks to Vectorize through the [[vectorize]] binding, not these vars)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX=schoolbook-ncert
